{
    "name": "moox/pdf",
    "description": "Moox PDF: render documents through a stable Moox API backed by TCPDF.",
    "keywords": [
        "Moox",
        "Laravel",
        "PDF",
        "TCPDF",
        "Moox package",
        "Laravel package"
    ],
    "homepage": "https://moox.org/docs/pdf",
    "license": "MIT",
    "authors": [
        {
            "name": "Moox Developer",
            "email": "dev@moox.org",
            "role": "Developer"
        }
    ],
    "require": {
        "moox/core": "dev-main",
        "tecnickcom/tcpdf": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Moox\\Pdf\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Moox\\Pdf\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Moox\\Pdf\\PdfServiceProvider"
            ]
        },
        "moox": {
            "stability": "dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "moox/devtools": "dev-main"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
