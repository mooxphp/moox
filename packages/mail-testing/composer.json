{
    "name": "moox/mail-testing",
    "description": "MJML render benchmark: personalized HTML generation PHP vs Node.",
    "keywords": [
        "Moox",
        "Laravel",
        "Filament",
        "mail",
        "MJML",
        "Moox package",
        "Laravel package"
    ],
    "homepage": "https://moox.org/docs/mail-testing",
    "license": "MIT",
    "authors": [
        {
            "name": "Moox Developer",
            "email": "dev@moox.org",
            "role": "Developer"
        }
    ],
    "require": {
        "moox/contact": "dev-main",
        "moox/core": "dev-main",
        "moox/mail-template": "dev-main",
        "moox/mjml": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "Moox\\MailTesting\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Moox\\MailTesting\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Moox\\MailTesting\\MailTestingServiceProvider"
            ]
        },
        "moox": {
            "stability": "dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "moox/devtools": "dev-main"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
