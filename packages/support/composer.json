{
    "name": "moox/support",
    "description": "Shared model and form traits.",
    "license": "MIT",
    "authors": [
        {
            "name": "Moox Developer",
            "email": "dev@moox.org",
            "role": "Developer"
        }
    ],
    "require": {
        "filament/forms": "^5.0",
        "filament/schemas": "^5.0",
        "filament/tables": "^5.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "moox/core": "dev-main",
        "astrotomic/laravel-translatable": "^11.17"
    },
    "autoload": {
        "psr-4": {
            "Moox\\Support\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Moox\\Support\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Moox\\Support\\SupportServiceProvider"
            ]
        },
        "moox": {
            "stability": "stable"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.3"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
