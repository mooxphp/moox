{
    "name": "moox/login-link",
    "description": "This is my package login-link",
    "keywords": [
        "Laravel",
        "Filament",
        "Filament plugin",
        "Laravel package"
    ],
    "homepage": "https://moox.org/",
    "license": "MIT",
    "authors": [
        {
            "name": "Moox Developer",
            "email": "dev@moox.org",
            "role": "Developer"
        }
    ],
    "require": {
        "moox/core": "dev-main",
        "moox/slug": "dev-main"
    },
    "require-dev": {
        "moox/devtools": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "Moox\\LoginLink\\": "src",
            "Moox\\LoginLink\\Database\\Seeders\\": "database/seeders"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Moox\\LoginLink\\Tests\\": "tests"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Moox\\LoginLink\\LoginLinkServiceProvider"
            ]
        },
        "moox": {
            "stability": "stable",
            "install": {
                "seed": "database/seeders/LoginLinkProcessSeeder.php"
            }
        }
    },
    "prefer-stable": true
}