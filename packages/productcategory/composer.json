{
    "name": "moox/productcategory",
    "description": "Moox product family entity with translatable content.",
    "keywords": [
        "Moox",
        "Laravel",
        "Filament",
        "Moox package",
        "Laravel package",
        "Product"
    ],
    "homepage": "https://moox.org/docs/productcategory",
    "license": "MIT",
    "authors": [
        {
            "name": "Moox Developer",
            "email": "dev@moox.org",
            "role": "Developer"
        }
    ],
    "require": {
        "moox/core": "dev-main",
        "moox/localization": "dev-main",
        "moox/media": "dev-main",
        "moox/support": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "Moox\\ProductCategory\\": "src",
            "Moox\\ProductCategory\\Database\\Factories\\": "database/factories",
            "Moox\\ProductCategory\\Database\\Seeders\\": "database/seeders"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Moox\\ProductCategory\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Moox\\ProductCategory\\ProductCategoryServiceProvider"
            ]
        },
        "moox": {
            "name": "Moox ProductCategory",
            "stability": "stable",
            "type": "moox-plugin",
            "install": {
                "auto_migrate": "database/migrations",
                "seed": "database/seeders/ProductCategorySeeder.php",
                "auto_publish": "moox-productcategory-config",
                "auto_entities": {
                    "ProductCategory": true
                },
                "auto_class": {
                    "ProductCategory": "Moox\\ProductCategory\\Models\\ProductCategory"
                }
            },
            "update": {
                "migrate": "database/migrations",
                "merge": "moox-productcategory-config"
            },
            "uninstall": {
                "migrate": "database/migrations",
                "remove": "moox-productcategory-config"
            }
        }
    },
    "prefer-stable": true,
    "require-dev": {
        "moox/devtools": "dev-main"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}