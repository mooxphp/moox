{
    "name": "moox/msgraph",
    "description": "Microsoft Graph SDK integration for Laravel — connection registry, authenticated client factory, and immutable-ID middleware.",
    "keywords": [
        "Moox",
        "Laravel",
        "Microsoft Graph",
        "OAuth2",
        "API client"
    ],
    "homepage": "https://moox.org/docs/msgraph",
    "license": "MIT",
    "authors": [
        {
            "name": "Moox Developer",
            "email": "dev@moox.org",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "moox/core": "dev-main",
        "microsoft/microsoft-graph": "^2.0",
        "guzzlehttp/guzzle": "^7.5"
    },
    "autoload": {
        "psr-4": {
            "Moox\\Msgraph\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Moox\\Msgraph\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Moox\\Msgraph\\MsgraphServiceProvider"
            ]
        },
        "moox": {
            "stability": "dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "moox/devtools": "dev-main",
        "pestphp/pest": "^4.0",
        "orchestra/testbench": "^10.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
