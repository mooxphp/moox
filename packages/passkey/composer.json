{
    "name": "moox/passkey",
    "description": "Passkeys for Moox panels via laravel/passkeys and adriaanzon/filament-passkeys",
    "keywords": [
        "Laravel",
        "Filament",
        "Filament plugin",
        "Laravel package",
        "Passkeys",
        "WebAuthn"
    ],
    "homepage": "https://moox.org/",
    "license": "MIT",
    "authors": [
        {
            "name": "Moox Developer",
            "email": "dev@moox.org",
            "role": "Developer"
        }
    ],
    "require": {
        "moox/core": "dev-main",
        "adriaanzon/filament-passkeys": "^0.3",
        "laravel/passkeys": "^0.2.1"
    },
    "require-dev": {
        "moox/devtools": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "Moox\\Passkey\\": "src"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Moox\\Passkey\\PasskeyServiceProvider"
            ]
        },
        "moox": {
            "stability": "dev",
            "install": {
                "plugins": [
                    "Moox\\Passkey\\Plugins\\PasskeyPlugin"
                ]
            }
        }
    },
    "prefer-stable": true
}
