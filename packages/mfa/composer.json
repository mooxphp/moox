{
    "name": "moox/mfa",
    "description": "Filament App Authentication (TOTP) MFA for Moox panels",
    "keywords": [
        "Laravel",
        "Filament",
        "Filament plugin",
        "Laravel package",
        "MFA",
        "TOTP"
    ],
    "homepage": "https://moox.org/",
    "license": "MIT",
    "authors": [
        {
            "name": "Moox Developer",
            "email": "dev@moox.org",
            "role": "Developer"
        }
    ],
    "require": {
        "moox/core": "dev-main"
    },
    "require-dev": {
        "moox/devtools": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "Moox\\Mfa\\": "src"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Moox\\Mfa\\MfaServiceProvider"
            ]
        },
        "moox": {
            "stability": "dev",
            "install": {
                "plugins": [
                    "Moox\\Mfa\\Plugins\\MfaPlugin"
                ]
            }
        }
    },
    "prefer-stable": true
}
