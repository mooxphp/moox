{
    "name": "moox/mjml",
    "description": "Moox MJML: convert MJML to HTML via shyim (default) or Spatie/npm.",
    "keywords": [
        "Moox",
        "Laravel",
        "MJML",
        "email",
        "Moox package",
        "Laravel package"
    ],
    "homepage": "https://moox.org/docs/mjml",
    "license": "MIT",
    "authors": [
        {
            "name": "Moox Developer",
            "email": "dev@moox.org",
            "role": "Developer"
        }
    ],
    "require": {
        "moox/core": "dev-main",
        "shyim/mjml-php": "^0.2",
        "spatie/mjml-php": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "Moox\\Mjml\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Moox\\Mjml\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Moox\\Mjml\\MjmlServiceProvider"
            ]
        },
        "moox": {
            "stability": "dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "moox/devtools": "dev-main"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
